{
  "pluginAlias": "SleepysElite",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Sleepy's Elite",
        "required": true
      },
      "deviceNamePrefix": {
        "title": "Bed Bluetooth Name Prefix",
        "type": "string",
